        <mxCell id="4" value="&lt;b&gt;01  Video đã được chọn&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;App: tự kích hoạt khi đủ cảnh&lt;br/&gt;LAN: người dùng bấm dựng&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
