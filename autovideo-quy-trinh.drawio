        <mxCell id="19" value="Ba cách sửa bản đã hoàn thành" style="swimlane;html=1;startSize=40;horizontal=1;rounded=1;collapsible=0;container=1;pointerEvents=0;fillColor=#f8fafc;swimlaneFillColor=#ffffff;strokeColor=#cbd5e1;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#334155;" vertex="1" parent="1">
