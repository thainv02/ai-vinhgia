        <mxCell id="11" value="&lt;b&gt;08  Bản hoàn chỉnh vN&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;MP4 · ảnh xem trước&lt;br/&gt;lịch sử phiên bản&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
