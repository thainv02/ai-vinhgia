        </mxCell>
        <mxCell id="9" value="&lt;b&gt;06  Xoá logo Veo&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Chạy sau ghép nếu công cụ bật&lt;br/&gt;giữ bản raw để khôi phục&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
