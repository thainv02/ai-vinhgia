        <mxCell id="6" value="&lt;b&gt;03  Danh sách đoạn giữ&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;EDL được server kiểm tra&lt;br/&gt;người dùng sửa điểm cắt được&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="190" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;04  Xếp hàng render&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Hàng đợi chung, app trước LAN&lt;br/&gt;N việc song song, mặc định 2&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
