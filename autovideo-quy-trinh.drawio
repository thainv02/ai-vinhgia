  <diagram id="clips" name="05 · Video dài → clip">
    <mxGraphModel dx="1740" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1260" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Cắt video dài thành clip ngắn · App và LAN" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=32;fontColor=#243247;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="1580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Hiện dùng gipformer qua STT nội bộ · Điểm cắt dựa trên mốc từ, không lấy số giây do AI tự viết" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#526174;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="1580" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;01  Tải video dài&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;App: tối đa 4 GiB / 3 giờ&lt;br/&gt;LAN: 2 GiB / 90 phút&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;02  Tách audio&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;ffmpeg → mono 16 kHz&lt;br/&gt;cache theo nội dung + thuật ngữ&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="190" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;03  Nhận dạng tiếng Việt&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;gipformer qua dịch vụ STT nội bộ&lt;br/&gt;trả lời thoại và mốc từng từ&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="190" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;04  Dựng lời thoại &amp;amp; câu&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Đo khoảng lặng thật bằng ffmpeg&lt;br/&gt;chia câu mịn, bám điểm cắt&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="190" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;05  AI đề xuất đoạn hay&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;clip_plan: theo chủ đề, độ dài&lt;br/&gt;chọn bằng ID câu + câu trích&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="450" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;06  Kiểm định &amp;amp; sửa một lần&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Xem đoạn + ngữ cảnh + lưới hình&lt;br/&gt;khôi phục dấu câu cho phụ đề&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="450" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;07  Duyệt / bỏ / sửa vùng từ&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Tua theo lời thoại, sửa đầu/cuối&lt;br/&gt;hoặc tạo đoạn thủ công&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="450" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;08  Sửa phụ đề&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Chỉnh chữ, tên riêng, ẩn/gộp từ&lt;br/&gt;giữ ánh xạ thời gian&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;09  Chọn khung &amp;amp; kiểu phụ đề&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;9:16 / 1:1 / 16:9 / nguồn&lt;br/&gt;center hoặc fit nền mờ&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="710" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;10  Hàng đợi render chung&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;App trước LAN, N việc song song&lt;br/&gt;có tiến độ và hủy&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="710" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;11  Dựng bằng ffmpeg&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Cắt → khung hình → phụ đề ASS&lt;br/&gt;âm thanh fade ở hai đầu&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="710" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;12  Xem &amp;amp; tải bộ clip&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot;&gt;MP4 từng clip · SRT&lt;br/&gt;ZIP các clip đã dựng xong&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontFamily=Arial;fontSize=17;fontColor=#243247;spacing=12;align=center;verticalAlign=middle;container=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="710" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=1.7;fontFamily=Arial;fontSize=14;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5">
          <mxGeometry x="0" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=1.7;fontFamily=Arial;fontSize=14;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6">
          <mxGeometry x="0" relative="1" as="geometry" />
