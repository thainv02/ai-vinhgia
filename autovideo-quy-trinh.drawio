        <mxCell id="24" value="Lỗi / hủy: giữ các bản đã có, có thể chạy lại riêng bước xoá logo hoặc chỉnh màu. App chủ máy mở .mlt trong Shotcut khi có file; LAN xem và tải." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#243247;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
