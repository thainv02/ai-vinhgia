# Cấu hình của app desktop. Bản cài dùng <thư mục dữ liệu>/config.env (khóa API AI nhập trong Cài đặt sẽ được ghi vào đó);
# khi chạy từ repo thì dùng .env ở thư mục gốc. Thiếu file thì server tự tạo và sinh WORKER_TOKEN.
PORT=8787
# Cổng của giao diện (trang planner, chỉ nghe 127.0.0.1)
# LAN_PORT=8790
# Thư mục gốc chứa output/ và refs/ (mặc định: thư mục dữ liệu)
ROOT_DIR=
# Đường dẫn file SQLite (tương đối so với ROOT_DIR)
DB_PATH=data/app.db
# Token nội bộ giữa server và worker AI nhúng. Để trống thì tự sinh ngẫu nhiên và ghi vào file cấu hình.
WORKER_TOKEN=
# Job mất heartbeat quá số phút này sẽ bị trả về hàng đợi
HEARTBEAT_STALE_MINUTES=5
# Worker được coi là online nếu có request trong số giây này
WORKER_ONLINE_SECONDS=90

# --- Dựng bản hoàn chỉnh (sau khi mọi cảnh đã chọn video) ---
# Bản hoàn chỉnh luôn dựng bằng ffmpeg.
# ffmpeg/ffprobe tùy chọn (mặc định tìm trong PATH, rồi thư mục bin/ cạnh app)
FFMPEG_PATH=
FFPROBE_PATH=
# Số việc render/xoá logo chạy CÙNG LÚC trong hàng đợi render. Mặc định 2, kẹp 1–4. Mỗi việc xoá logo mở một Chromium riêng (~vài trăm MB RAM).
RENDER_CONCURRENCY=auto
# Số đoạn HTML compose cùng lúc, 1–3; đoạn đầu chạy trước để chốt phong cách.
HTML_COMPOSE_PARALLEL=2

# --- Xoá logo Veo trên bản dựng hoàn chỉnh (tools/gwr: phần video của @pilio/gemini-watermark-remover, cài qua npm) ---
# Cần Microsoft Edge hoặc Google Chrome trên máy (chạy ẩn). GWR_BROWSER_PATH: đường dẫn trình duyệt nếu cài ở chỗ khác.
# auto: bật nếu GWR_CLI tồn tại và `node <GWR_CLI> --help` chạy được (có trình duyệt); off: bỏ qua bước này (video ra còn logo)
WATERMARK_REMOVER=auto
# Đường dẫn TUYỆT ĐỐI tới tool (mặc định: <app>/tools/gwr/gwr.mjs)
GWR_CLI=
# GWR_BROWSER_PATH=
# Bitrate video (Mbps) cho tool; để trống = mặc định của tool
GWR_VIDEO_BITRATE_MBPS=
# Quá số mili giây này thì hủy bước xoá logo (mặc định 30 phút)
GWR_TIMEOUT_MS=

# --- API AI (chuẩn OpenAI, gọi thẳng) ---
# Mặc định http://ai.duocvinhgia.com/v1 (CLIProxyAPI tự host; tạm HTTP vì chưa có chứng chỉ HTTPS); key nhập trong Cài đặt của app.
# KHÔNG commit key thật.
# AI_API_URL=http://ai.duocvinhgia.com/v1
# AI_API_KEY=
# AI_MODEL=claude-sonnet-4-6
# Model nhẹ cho việc phụ (chuẩn hoá chính tả lời thoại). Bỏ trống = tự chọn trong danh sách model (haiku / lite / mini / flash), không có thì dùng AI_MODEL.
# AI_FAST_MODEL=
# File cấu hình khác (chạy thử với cấu hình tạm, không đụng file thật)
# AUTOVIDEO_ENV_FILE=

# --- Cắt clip từ video dài (long video -> shorts) ---
# STT_PROVIDER: local | omnix | none.
#   local: nhận dạng ngay trên máy bằng CPU (model gipformer 1.5 INT8 ~73 MB qua sherpa-onnx). Mặc định local; bộ cài chép sẵn model
#          vào %LOCALAPPDATA%\vn.syntra.autovideo\models, thiếu thì tải ở Cài đặt > Nhận dạng lời nói. Dev: tải bằng
#          `node --import tsx server/src/scripts/stt-model-cli.ts --dir <STT_MODELS_DIR>`.
#   omnix: dịch vụ STT nội bộ (chuẩn OpenAI), xử lý MỘT file một lúc. Để trống: omnix nếu có STT_URL, ngược lại none.
STT_PROVIDER=
# STT_MODELS_DIR=<ROOT_DIR>/models   (local: thư mục chứa model; bản desktop do vỏ app truyền --stt-models-dir)
# STT_THREADS=                       (local: số luồng CPU, mặc định số nhân - 1, tối đa 4)
# STT_AI_FIX=1                       (AI nhẹ sửa chính tả, tên riêng, dấu câu của lời thoại trước khi hiển thị; 0 = tắt)
# URL đầy đủ của endpoint transcriptions (chỉ HTTP, HTTPS của dịch vụ không chạy):
STT_URL=http://10.0.3.214:18085/v1/audio/transcriptions
# Header X-Tenant-ID khi lấy lại kết quả theo job id (GET /v1/stt/jobs/{id})
STT_TENANT_ID=s-omnix-studio
# Thời gian chờ tối đa một lần nhận dạng (ms, mặc định 1 giờ) và số lần thử lại khi dịch vụ báo lỗi tạm (backoff 10 s / 30 s / 90 s)
STT_TIMEOUT_MS=3600000
STT_MAX_RETRIES=3
# Giới hạn video nguồn (byte, giây)
CLIP_SOURCE_MAX_BYTES=4294967296
CLIP_SOURCE_MAX_S=10800
# Dung lượng trống (GB) phải còn lại sau khi tải lên (cần thêm 3 x kích thước file) và trước khi dựng clip; thiếu thì báo 507
CLIP_MIN_FREE_GB=10
# Phụ đề ASS (libass): tên font (family, luôn đậm; phải có đủ dấu tiếng Việt) và thư mục font cho libass.
# Mặc định Arial: server chép Arial Bold của macOS vào <thư mục DB>/clip-fonts. Đặt CLIP_FONTS_DIR để dùng font riêng (Be Vietnam Pro, ...).
CLIP_CAPTION_FONT=Arial
CLIP_FONTS_DIR=
# ffmpeg CÓ libass (bộ lọc `subtitles`) + boxblur + libx264 để cháy phụ đề. ffmpeg của Homebrew hiện KHÔNG có libass: cài `brew install ffmpeg-full`
# (server tự dò /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg) hoặc đặt đường dẫn tuyệt đối ở đây. Không có thì chỉ dựng được "Không phụ đề".
CLIP_FFMPEG_PATH=
