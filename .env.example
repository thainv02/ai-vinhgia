# Sao chép thành .env để chỉnh. Nếu không có .env, lần chạy server đầu tiên sẽ tự tạo và sinh WORKER_TOKEN.
PORT=8787
# Thư mục gốc chứa output/ và refs/ (mặc định: thư mục gốc repo)
ROOT_DIR=
# Đường dẫn file SQLite (tương đối so với ROOT_DIR)
DB_PATH=data/app.db
# Token cho worker (Claude Code). Để trống thì tự sinh ngẫu nhiên và ghi vào .env.
WORKER_TOKEN=
# Số job video tối đa chạy cùng lúc trên Flow
MAX_CONCURRENT_VIDEO_JOBS=4
# true: cảnh mới phải được người dùng duyệt prompt trước khi tạo storyboard
REQUIRE_PROMPT_APPROVAL=true
# Job mất heartbeat quá số phút này sẽ bị trả về hàng đợi
HEARTBEAT_STALE_MINUTES=5
# Worker được coi là online nếu có request trong số giây này
WORKER_ONLINE_SECONDS=90
# (tuỳ chọn) Origin bổ sung được phép gọi API ghi, cách nhau bằng dấu phẩy
EXTRA_ALLOWED_ORIGINS=

# --- Dựng bản hoàn chỉnh (sau khi mọi cảnh đã chọn video) ---
# Bản hoàn chỉnh luôn dựng bằng ffmpeg. (FINAL_RENDERER / SHOTCUT_MCP_* của bản cũ nếu còn trong file sẽ bị bỏ qua.)
# ffmpeg/ffprobe tùy chọn (mặc định tìm trong PATH, rồi thư mục bin/ cạnh app)
FFMPEG_PATH=
FFPROBE_PATH=

# --- Xoá logo Veo trên bản dựng hoàn chỉnh (tool gemini-watermark-remover) ---
# auto: bật nếu GWR_CLI tồn tại và `node <GWR_CLI> --help` chạy được; off: bỏ qua bước này (video ra còn logo)
WATERMARK_REMOVER=auto
# Đường dẫn TUYỆT ĐỐI tới bin/gwr.mjs (mặc định: <repo>/gemini-watermark-remover/bin/gwr.mjs)
GWR_CLI=
# Bitrate video (Mbps) cho tool; để trống = mặc định của tool
GWR_VIDEO_BITRATE_MBPS=
# Quá số mili giây này thì hủy bước xoá logo (mặc định 30 phút)
GWR_TIMEOUT_MS=
