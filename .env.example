# Sao chép thành .env để chỉnh. Nếu không có .env, lần chạy server đầu tiên sẽ tự tạo và sinh WORKER_TOKEN.
PORT=8787
HOST=127.0.0.1
# Thư mục gốc chứa output/ và refs/ (mặc định: thư mục gốc repo)
ROOT_DIR=
# Đường dẫn file SQLite (tương đối so với ROOT_DIR)
DB_PATH=data/app.db
# Token cho worker (Claude Code). Để trống thì tự sinh ngẫu nhiên và ghi vào .env.
WORKER_TOKEN=
# Số job video tối đa chạy cùng lúc trên Flow
MAX_CONCURRENT_VIDEO_JOBS=4
# true: cảnh mới phải được người dùng duyệt prompt trước khi tạo storyboard
REQUIRE_PROMPT_APPROVAL=true
# Job mất heartbeat quá số phút này sẽ bị trả về hàng đợi
HEARTBEAT_STALE_MINUTES=5
# Worker được coi là online nếu có request trong số giây này
WORKER_ONLINE_SECONDS=90
# (tuỳ chọn) Origin bổ sung được phép gọi API ghi, cách nhau bằng dấu phẩy
EXTRA_ALLOWED_ORIGINS=

# --- Dựng bản hoàn chỉnh (sau khi mọi cảnh đã chọn video) ---
# auto: dùng Shotcut (qua MCP) nếu cấu hình đủ và `--check` của MCP chạy được, ngược lại dùng ffmpeg.
# Giá trị: auto | shotcut | ffmpeg
FINAL_RENDERER=auto
# Shotcut MCP (đường dẫn TUYỆT ĐỐI). Server chạy: <python> <script> với SHOTCUT_MCP_ALLOWED_ROOTS=<ROOT_DIR>
# Ví dụ:
#   SHOTCUT_MCP_PYTHON=/Users/<bạn>/.local/share/uv/python/cpython-3.12-macos-aarch64-none/bin/python3.12
#   SHOTCUT_MCP_SERVER_SCRIPT=/Users/<bạn>/code/shotcut-mcp/scripts/shotcut_mcp_server.py
SHOTCUT_MCP_PYTHON=
SHOTCUT_MCP_SERVER_SCRIPT=
# ffmpeg/ffprobe tùy chọn (mặc định tìm trong PATH, rồi /Applications/Shotcut.app/Contents/MacOS/)
FFMPEG_PATH=
FFPROBE_PATH=
# Số việc render/xoá logo chạy CÙNG LÚC trong hàng đợi render (bản dựng của app + LAN và việc xoá logo LAN). Mặc định 2, kẹp 1–4.
# Việc của dự án app vẫn được lấy trước việc LAN đang chờ; việc đang chạy không bị ngắt. Mỗi việc xoá logo mở một Chromium riêng (~vài trăm MB RAM),
# mỗi render Shotcut một tiến trình MCP riêng. Đặt > 2 thì server tự nâng SHOTCUT_MCP_MAX_ACTIVE_RENDERS (mặc định 2 của Shotcut MCP) cho MCP khi mở nó.
RENDER_CONCURRENCY=2

# --- Thùng rác dự án ---
# Xoá dự án = chuyển vào thùng rác (khôi phục được). Quá số ngày này thì tự xoá vĩnh viễn (số nguyên >= 1; sai/để trống = 30). Kiểm tra lúc khởi động và mỗi giờ.
TRASH_RETENTION_DAYS=30

# --- Xoá logo Veo trên bản dựng hoàn chỉnh (tool gemini-watermark-remover) ---
# auto: bật nếu GWR_CLI tồn tại và `node <GWR_CLI> --help` chạy được; off: bỏ qua bước này (video ra còn logo)
WATERMARK_REMOVER=auto
# Đường dẫn TUYỆT ĐỐI tới bin/gwr.mjs (mặc định: <repo>/gemini-watermark-remover/bin/gwr.mjs)
GWR_CLI=
# Bitrate video (Mbps) cho tool; để trống = mặc định của tool
GWR_VIDEO_BITRATE_MBPS=
# Quá số mili giây này thì hủy bước xoá logo (mặc định 30 phút)
GWR_TIMEOUT_MS=

# Account pool (legacy giữ cách chạy hiện tại; managed bật worker độc lập)
WORKER_MODE=legacy
# Chỉ có tác dụng khi WORKER_MODE=managed: loại job do managed worker nhận (cách nhau dấu phẩy). Để trống = mọi loại.
# Loại còn lại do worker legacy (Claude Code theo WORKER.md) nhận. Ví dụ chế độ kết hợp:
# MANAGED_JOB_TYPES=analyze_brief,revise_prompt,edit_plan
# Credential store riêng ngoài repo (mặc định theo DB_PATH)
# AI_HOME=/absolute/private/autovideo-accounts
# BROWSER_CDP_URL=http://127.0.0.1:9222

# --- Trang planner cho người dùng trong mạng LAN (listener riêng, MẶC ĐỊNH TẮT) ---
# Đồng nghiệp mở http://<IP máy>:<LAN_PORT> (mặc định KHÔNG cần mã truy cập), gửi yêu cầu + ảnh tham chiếu và nhận prompt cho ChatGPT/Google Flow.
# Trang đó chỉ lập kế hoạch: không tạo storyboard/video trên máy này. App chính vẫn chỉ nghe HOST (127.0.0.1). Xem docs/ai/OPERATIONS.md.
# Chỉ giá trị true/1/yes/on mới bật; đổi xong cần khởi động lại server.
LAN_ENABLED=false
# LAN_HOST=0.0.0.0
# LAN_PORT=8790
# Mặc định false: trang mở ngay, không có màn đăng nhập/phiên (vẫn giữ kiểm tra Host, Origin, chặn cross-site, CSP, giới hạn theo IP,
# trần hàng đợi LAN, danh sách file được phép). true: đòi mã truy cập chung như trước (cần LAN_ACCESS_CODE). Giá trị lạ/gõ sai được hiểu là true.
LAN_REQUIRE_CODE=false
# Chỉ dùng khi LAN_REQUIRE_CODE=true: mã truy cập chung (>= 6 ký tự). Để trống: server tự sinh mã 8 ký tự và ghi vào đây (như WORKER_TOKEN).
# Khi LAN_REQUIRE_CODE=false server không sinh và không đòi mã.
LAN_ACCESS_CODE=
# Hostname nội bộ bổ sung được chấp nhận trong header Host (IP, localhost, *.local, tên một nhãn luôn được chấp nhận)
# LAN_ALLOWED_HOSTS=video.congty.lan
# File .env khác (chạy thử với cấu hình tạm, không đụng .env thật)
# AUTOVIDEO_ENV_FILE=

# --- Cắt clip từ video dài (long video -> shorts) ---
# Nhận dạng lời nói bằng dịch vụ STT nội bộ (Omnix, chuẩn OpenAI), KHÔNG chạy model trên máy này. Dịch vụ xử lý MỘT file một lúc.
# STT_PROVIDER: omnix | none. Để trống: omnix nếu có STT_URL, ngược lại none (giao diện báo "chưa cấu hình nhận dạng lời nói").
STT_PROVIDER=
# URL đầy đủ của endpoint transcriptions (chỉ HTTP, HTTPS của dịch vụ không chạy):
STT_URL=http://10.0.3.214:18085/v1/audio/transcriptions
# Header X-Tenant-ID khi lấy lại kết quả theo job id (GET /v1/stt/jobs/{id})
STT_TENANT_ID=s-omnix-studio
# Thời gian chờ tối đa một lần nhận dạng (ms, mặc định 1 giờ) và số lần thử lại khi dịch vụ báo lỗi tạm (backoff 10 s / 30 s / 90 s)
STT_TIMEOUT_MS=3600000
STT_MAX_RETRIES=3
# Giới hạn video nguồn của app chính (byte, giây) và của trang LAN (cùng giới hạn tuyệt đối của dịch vụ: 500 MB audio, 3 giờ)
CLIP_SOURCE_MAX_BYTES=4294967296
CLIP_SOURCE_MAX_S=10800
LAN_CLIP_SOURCE_MAX_BYTES=2147483648
LAN_CLIP_SOURCE_MAX_S=10800
# Dung lượng trống (GB) phải còn lại sau khi tải lên (cần thêm 3 x kích thước file) và trước khi dựng clip; thiếu thì báo 507
CLIP_MIN_FREE_GB=10
# Video nguồn của dự án LAN tự xoá sau số ngày này (giữ transcript, bản xem thử 480p và clip đã dựng)
LAN_CLIP_SOURCE_RETENTION_DAYS=7
# Phụ đề ASS (libass): tên font (family, luôn đậm; phải có đủ dấu tiếng Việt) và thư mục font cho libass.
# Mặc định Arial: server chép Arial Bold của macOS vào <thư mục DB>/clip-fonts. Đặt CLIP_FONTS_DIR để dùng font riêng (Be Vietnam Pro, ...).
CLIP_CAPTION_FONT=Arial
CLIP_FONTS_DIR=
# ffmpeg CÓ libass (bộ lọc `subtitles`) + boxblur + libx264 để cháy phụ đề. ffmpeg của Homebrew hiện KHÔNG có libass: cài `brew install ffmpeg-full`
# (server tự dò /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg) hoặc đặt đường dẫn tuyệt đối ở đây. Không có thì chỉ dựng được "Không phụ đề".
CLIP_FFMPEG_PATH=
